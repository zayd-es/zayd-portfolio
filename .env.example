# Public URL of the deployed site (used for metadata, sitemap, hreflang and OG images)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend API key (server only, never exposed to the browser)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: sender used by the contact form. Defaults to Resend's test sender
# (onboarding@resend.dev), which can only deliver to your own Resend account
# email. After verifying a domain in Resend, set e.g. "Zayd <hello@your-domain.com>".
CONTACT_FROM_EMAIL=
